/* MinigameUI.uss
 * Styling for minigame UI components
 * Basic styling to make minigames functional and readable
 */

/* Minigame Root Container */
.minigame-root {
    width: 100%;
    height: 100%;
    padding: 20px;
    background-color: rgba(0, 0, 0, 0.8);
    border-radius: 10px;
    align-items: center;
    justify-content: flex-start;
}

/* Title */
.minigame-title {
    font-size: 32px;
    color: rgb(255, 215, 0); /* Gold */
    -unity-font-style: bold;
    margin-bottom: 20px;
    -unity-text-align: upper-center;
}

/* Target Phrase Display */
.target-phrase {
    font-size: 24px;
    color: rgb(255, 255, 255);
    background-color: rgba(50, 50, 50, 0.8);
    padding: 15px;
    margin-bottom: 10px;
    border-radius: 5px;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Typed Text Display */
.typed-text {
    font-size: 24px;
    color: rgb(0, 255, 0); /* Green */
    background-color: rgba(0, 0, 0, 0.6);
    padding: 15px;
    margin-bottom: 20px;
    border-radius: 5px;
    min-height: 50px;
    -unity-text-align: middle-center;
}

/* Stats Container */
.stats-container {
    width: 100%;
    margin-top: 20px;
    margin-bottom: 20px;
    padding: 10px;
    background-color: rgba(40, 40, 40, 0.7);
    border-radius: 5px;
}

/* Mistake Counter */
.mistake-count {
    font-size: 18px;
    color: rgb(255, 255, 255);
    margin-bottom: 5px;
}

.mistake-count.warning {
    color: rgb(255, 100, 100); /* Red warning */
    -unity-font-style: bold;
}

/* Mistake Bar */
.mistake-bar {
    width: 100%;
    height: 20px;
    margin-bottom: 10px;
}

.mistake-bar.warning {
    background-color: rgb(255, 50, 50); /* Red */
}

/* Timer Label */
.timer-label {
    font-size: 18px;
    color: rgb(255, 255, 255);
}

.timer-label.warning {
    color: rgb(255, 200, 0); /* Yellow warning */
    -unity-font-style: bold;
}

/* Feedback Container */
.feedback-container {
    width: 100%;
    min-height: 100px;
    align-items: center;
    justify-content: center;
    margin-top: 20px;
}

/* Feedback Flash (Correct/Incorrect) */
.feedback-flash {
    font-size: 20px;
    -unity-font-style: bold;
    padding: 5px 10px;
    margin: 2px;
}

/* Success Message */
.success-message {
    font-size: 36px;
    color: rgb(0, 255, 0); /* Green */
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 30px;
    background-color: rgba(0, 100, 0, 0.3);
    border-radius: 10px;
    white-space: normal;
}

/* Failure Message */
.failure-message {
    font-size: 36px;
    color: rgb(255, 100, 100); /* Red */
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 30px;
    background-color: rgba(100, 0, 0, 0.3);
    border-radius: 10px;
    white-space: normal;
}

/* Minigame Container (in DialogBox) */
.minigame-container {
    width: 100%;
    height: 100%;
}
